# Base URL of the ep-api instance, including the `/api` prefix.
# Matches the convention used by chm-website, ep-deaisummit2026, etc.
NEXT_PUBLIC_GCONF_API_URL=https://api.gconf.ai/api

# Tenant API key for gconf.ai — resolves the tenant automatically on the server.
# Get it from ep-dashboard → Platform → Tenants → view tenant → API Key card.
NEXT_PUBLIC_GCONF_API_KEY=382d06fc-a1fc-49d2-8a4a-711c4d8703fa

# Preferred: server-only site key (sk_site_…). When set, the site authenticates
# as the site instead of the tenant. Do NOT use NEXT_PUBLIC_ for this in prod.
# GCONF_SITE_KEY=sk_site_...

# Canonical site URL used for sitemap.xml, JSON-LD, OG tags, llms.txt.
NEXT_PUBLIC_SITE_URL=https://gconf.ai

# Supabase Storage hostname for next/image remote patterns (blog images).
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=
